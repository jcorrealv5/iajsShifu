<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>TraduccionTexto</title>
</head>
<body style="background-color:lightblue">
    <div>
        <h1>Demo 03: Traducir un texto de un archivo seleccionado de castellano a otros idiomas</h1>
        <h2>Ingresa un Texto en castellano a traducir</h2>
        <input id="txtArchivo" type="text" style="width:500px" />
        <input id="btnSeleccionar" type="button" value="..." />
        <input id="fupArchivo" type="file" accept="plain/text" style="display:none" />
        <select id="cboIdioma" disabled="disabled">
            <option value="en">Ingles</option>
            <option value="fr">Frances</option>
            <option value="ja">Japones</option>
            <option value="pt">Portugues</option>
        </select>
        <input id="btnTraducir" type="button" value="Traducir" disabled="disabled" />
        <input id="btnNuevo" type="button" value="Nuevo" />
        <h3>Texto en Castellano</h3>
        <div id="divTexto" style="width:1200px;height:250px;overflow-y:auto;background-color:white"></div>
        <div>Progreso de Traduccion: <span id="spnProgreso"></span>
            <progress id="progreso" value="0" min="0" max="100" style="width:800px"/>
        </div>
        <h3>Texto en Ingles</h3>
        <div id="divTraduccion" style="width:1200px;height:250px;overflow-y:auto;background-color:white"></div>
    </div>
    <script src="~/Scripts/TraduccionArchivo.js"></script>
</body>
</html>
