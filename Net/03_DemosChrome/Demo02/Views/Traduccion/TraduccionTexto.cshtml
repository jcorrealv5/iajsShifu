<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>TraduccionTexto</title>
</head>
<body style="background-color:lightblue">
    <div>
        <h1>Demo 02: Traducir un texto ingresado de castellano a otros idiomas</h1>
        <h2>Ingresa un Texto en castellano a traducir</h2>
        <input id="txtTexto" type="text" style="width:500px" />
        <select id="cboIdioma" disabled="disabled">
            <option value="en">Ingles</option>
            <option value="fr">Frances</option>
            <option value="ja">Japones</option>
            <option value="pt">Portugues</option>
        </select>
        <input id="btnTraducir" type="button" value="Traducir" disabled="disabled" />
        <input id="btnNuevo" type="button" value="Nuevo"/>
        <h3>Texto en Ingles</h3>
        <div id="divTraduccion" style="width:500px;height:300px;overflow-y:auto"></div>
    </div>
    <script src="~/Scripts/TraduccionTexto.js"></script>
</body>
</html>
