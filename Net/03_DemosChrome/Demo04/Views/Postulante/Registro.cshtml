<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Registro del Postulante</title>
</head>
<body style="background-color:lightblue">
    <div id="divPrincipal">
        <div>
            <input id="btnCastellano" type="button" value="Castellano" data-idioma="" />
            <input id="btnIngles" type="button" value="Ingles" data-idioma="en" />
            <input id="btnFrances" type="button" value="Frances" data-idioma="fr" />
        </div>
        <h1>Registro del Postulante</h1>
        <h2>Datos del Postulante</h2>
        <table style="width:100%">
            <tr>
                <td style="width:20%">Apellidos</td>
                <td style="width:80%"><input id="txtApellido" type="text" style="width:400px" maxlength="50" class="R G"></td>
            </tr>
            <tr>
                <td>Nombres</td>
                <td><input id="txtNombre" type="text" style="width:400px" maxlength="50" class="R G"></td>
            </tr>
            <tr>
                <td>DNI</td>
                <td><input id="txtDNI" type="text" style="width:200px" maxlength="20" class="R N G"></td>
            </tr>
            <tr>
                <td>Fecha Nac</td>
                <td><input id="txtFechaNacimiento" type="date" style="width:130px" maxlength="10" class="R G"></td>
            </tr>
            <tr>
                <td>Area</td>
                <td><select id="cboArea" type="text" style="width:400px" class="R G"></select></td>
            </tr>
            <tr>
                <td>Cargo</td>
                <td><select id="cboCargo" type="text" style="width:400px" class="R G"></select></td>
            </tr>
            <tr>
                <td>Pretension Sueldo</td>
                <td><input id="txtPretensionSueldo" type="number" style="width:70px" maxlength="5" class="R G"></td>
            </tr>
            <tr>
                <td>Email</td>
                <td><input id="txtEmail" type="text" style="width:400px" maxlength="250" class="R G"></td>
            </tr>
            <tr>
                <td style="vertical-align:text-top">Foto del Postulante (jpg)</td>
                <td>
                    <input id="txtFoto" type="text" style="width:400px" class="R">
                    <button id="btnSeleccionarFoto" class="BotonSeleccion">...</button>
                    <input id="fupFoto" type="file" accept="image/*" style="display:none" />
                    <br />
                    <img id="imgFoto" width="130" height="100" />
                </td>
            </tr>
            <tr>
                <td style="vertical-align:text-top">CV del Postulante (pdf)</td>
                <td>
                    <input id="txtDoc" type="text" style="width:400px" class="R">
                    <button id="btnSeleccionarDoc" class="BotonSeleccion">...</button>
                    <input id="fupDoc" type="file" accept="application/pdf" style="display:none" />
                    <iframe id="ifrDoc" name="ifrDoc" style="width:1000px;height:300px"></iframe>
                </td>
            </tr>
        </table>
        <div style="text-align:center">
            <button id="btnRegistrar" class="Boton">Registrar</button>
            <button id="btnRegresar" class="Boton">Regresar</button>
        </div>
        <div style="text-align:center">
            <span id="spnMensaje" class="Mensaje"></span>
        </div>
        <h3><a href='@Url.Content("~")Postulante/Inicio'>Regresar</a></h3>
    </div>
    <script src="~/Scripts/General.js"></script>
    <script src="~/Scripts/Registro.js"></script>
</body>
</html>