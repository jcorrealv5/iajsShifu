<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>TraduccionTexto</title>
</head>
<body style="background-color:lightblue">
    <div>
        <h1>Demo 09: Resumir un texto de un archivo PDF seleccionado en Castellano o Ingles</h1>
        <h2>Selecciona un archivo PDF a traducir en castellano o ingles</h2>
        <input id="txtArchivo" type="text" style="width:500px" />
        <input id="btnSeleccionar" type="button" value="..." />
        <input id="fupArchivo" type="file" accept="application/pdf" style="display:none" />
        <input id="btnResumir" type="button" value="Resumir" disabled="disabled" />
        <input id="btnNuevo" type="button" value="Nuevo" />
        <input id="btnGrabarResumen" type="button" value="Grabar Resumen"/>
        <h3>Texto en: <span id="spnIdiomaActual"></span></h3>
        <div id="divTexto" style="width:1200px;height:250px;overflow-y:auto;background-color:white"></div>
        <h3>Texto Resumido</h3>
        <div id="divResumen" style="width:1200px;height:250px;overflow-y:auto;background-color:white"></div>
    </div>
    <script src="https://unpkg.com/pdfjs-dist@latest/build/pdf.min.mjs" type="module"></script>
    <script src="~/Scripts/ResumenArchivo.js" type="module"></script>
</body>
</html>
