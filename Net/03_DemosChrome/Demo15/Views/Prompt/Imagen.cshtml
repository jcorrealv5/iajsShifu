<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Imagen</title>
</head>
<body style="background-color:lightblue">
    <div>
        <h1>Demo 15: API Prompt con Imagen de Entrada</h1>
        <table>
            <tr>
                <td style="width:50%">Selecciona la Imagen</td>
                <td style="width:50%">Ingresa la pregunta con respecto a la imagen</td>
            </tr>
            <tr>
                <td>
                    <input id="txtArchivo" type="text" style="width:500px" />
                    <input id="btnSeleccionar" type="button" value="..." />
                    <input id="fupImagen" type="file" accept="image/*" style="display:none" multiple=""/>
                </td>
                <td>
                    <input id="txtMensaje" type="text" style="width:500px">
                    <input id="btnEnviarMensaje" type="button" value="EnviarMensaje" disabled="disabled" />
                    <input id="btnNuevo" type="button" value="Nuevo"/>
                </td>
            </tr>
            <tr>
                <td><img id="imgReferencia" src="" width="700" height="500"/></td>
                <td><div id="divRespuesta" style="width:700px;height:500px;overflow-y:auto;background-color:white"></div></td>
            </tr>
        </table>        
    </div>
    <script src="~/Scripts/Imagen.js"></script>
</body>
</html>
