<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>EscrituraTexto</title>
</head>
<body style="background-color:aqua">
    <div>
        <h1>Demo 12: API ReWriter para reescribir un texto</h1>
        <table>
            <tr>
                <td>Selecciona el Archivo de Texto con el contenido a ReEscribir:</td>
                <td>Selecciona el Tono</td>
                <td>Selecciona el Formato</td>
                <td>Selecciona el Tamanio</td>
            </tr>
            <tr>
                <td>
                    <input id="txtArchivo" type="text" style="width:500px" readonly="readonly" />
                    <input id="btnSeleccionar" type="button" value="..." />
                    <input id="fupArchivo" type="file" accept="text/plain" style="display:none" />
                </td>
                <td><select id="cboTono" style="width:200px"></select></td>
                <td><select id="cboFormato" style="width:200px"></select></td>
                <td><select id="cboTamanio" style="width:200px"></select></td>
            </tr>
            <tr>
                <td colspan="4">Ingresa el Contexto (entorno o situacion):</td>
            </tr>
            <tr>
                <td colspan="3"><input id="txtContexto" type="text" style="width:1000px" /></td>
                <td>
                    <input id="btnReEscribir" type="button" value="Re-Escribir" disabled="disabled" />
                    <input id="btnNuevo" type="button" value="Nuevo" />
                </td>
            </tr>
        </table>
        <div>
            <div id="divTextoEntrada" style="float:left;background-color:white;width:700px;height:500px;overflow-y:auto"></div>
            <div id="divTextoSalida" style="float: left; background-color:gray; width: 700px; height: 500px; overflow-y: auto"></div>
        </div>        
    </div>
    <script src="~/Scripts/ReEscrituraTexto.js"></script>
</body>
</html>
