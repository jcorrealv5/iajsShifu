<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>TraduccionTexto</title>
</head>
<body style="background-color:lightblue">
    <div>
        <h1>Demo 06: Traducir un texto de un archivo PDF seleccionado del idioma actual a otros idiomas</h1>
        <h2>Selecciona un archivo PDF a traducir</h2>
        <input id="txtArchivo" type="text" style="width:500px" />
        <input id="btnSeleccionar" type="button" value="..." />
        <input id="fupArchivo" type="file" accept="application/pdf" style="display:none" />
        <select id="cboIdioma" disabled="disabled">
        </select>
        <input id="btnTraducir" type="button" value="Traducir" disabled="disabled" />
        <input id="btnNuevo" type="button" value="Nuevo" />
        <h3>Texto en: <span id="spnIdiomaActual"></span></h3>
        <div id="divTexto" style="width:1200px;height:250px;overflow-y:auto;background-color:white"></div>
        <div>
            Progreso de Traduccion: <span id="spnProgreso"></span>
            <progress id="progreso" value="0" min="0" max="100" style="width:800px" />
        </div>
        <h3>Texto a: <span id="spnIdiomaTraducir"></span></h3>
        <div id="divTraduccion" style="width:1200px;height:250px;overflow-y:auto;background-color:white"></div>
    </div>
    <script src="https://unpkg.com/pdfjs-dist@latest/build/pdf.min.mjs" type="module"></script>
    <script src="~/Scripts/TraduccionArchivo.js" type="module"></script>
</body>
</html>
